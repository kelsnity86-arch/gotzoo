{
  "name": "gotzoo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run --config tools/sim/vitest.sim.config.mts",
    "build:artifact": "node tools/build-artifact.mjs",
    "build:apk": "node tools/build-artifact.mjs && mkdir -p dist-apk && cp dist-artifact/bbopzoo.html dist-apk/index.html && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0"
  }
}
