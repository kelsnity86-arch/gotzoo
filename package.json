    "typecheck": "tsc --noEmit",
    "sim": "vitest run --config tools/sim/vitest.sim.config.mts",
    "build:artifact": "node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0"
  }
}
